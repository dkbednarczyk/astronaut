---
import Project from "../components/Project.astro";
import Layout from "../layouts/Layout.astro";

const aboutMe = {
  linkedin: "https://www.linkedin.com/in/dkbednarczyk",
};

const projects = [
  {
    title: "madr",
    url: "https://github.com/dkbednarczyk/madr",
    description: "Utility to control VXE MAD R gaming mice",
    lang: "rust",
  },
  {
    title: "mup",
    url: "https://github.com/dkbednarczyk/mup",
    description: "A multitool for Minecraft servers",
    lang: "rust",
  },
  {
    title: "TheGreatBot",
    url: "https://github.com/dkbednarczyk/TheGreatBot",
    description: "A Minecraft whitelist alternative",
    lang: "java",
  },
  {
    title: "breakout",
    url: "https://github.com/dkbednarczyk/breakout",
    description: "An event-bus powered game made using Raylib",
    lang: "cpp",
  },
];
---

<Layout
    title="Damian Bednarczyk"
    description="I'm an undergraduate at Illinois State University studying computational mathematics with a minor in computer science."
>
    <section class="intro">
        <img
            src="/headshot.webp"
            alt="Headshot of Damian Bednarczyk"
            width="220"
            height="185"
            fetchpriority="high"
        />
        <h1 class="visually-hidden">Damian Bednarczyk, computational mathematics student and software developer</h1>
        <p>
            I'm an undergraduate at Illinois State University studying
            computational mathematics with a minor in computer science.
            You might be looking for my&nbsp;
            <a href={aboutMe.linkedin}>LinkedIn</a> or&nbsp;
            <a href="/resume.pdf">resume</a>.
        </p>
        <p>I'm currently working with a team on a <a href="https://vr-icm.github.io">VR building-simulation research project</a> exploring how BIM models can support construction training and student education.</p>
    </section>

    <section>
        <h2>Projects</h2>
        <div class="projects">
            {projects.map((project) => <Project project={project} />)}
        </div>
    </section>
</Layout>
