---
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";

const aboutMe = {
    github: "https://github.com/dkbednarczyk",
    email: "mailto:damian@bednarczyk.xyz",
};

const projects = [
    {
        title: "madr",
        url: "https://github.com/dkbednarczyk/madr",
        description:
            "Utility to control VXE MAD R gaming mice",
        lang: "rust",
    },
    {
        title: "mup",
        url: "https://github.com/dkbednarczyk/mup",
        description: "A multitool for Minecraft servers",
        lang: "rust",
    },
    {
        title: "TheGreatBot",
        url: "https://github.com/dkbednarczyk/TheGreatBot",
        description: "A Discord-bot-based Minecraft whitelist alternative",
        lang: "java",
    },
    {
        title: "breakout",
        url: "https://github.com/dkbednarczyk/breakout",
        description: "An event-bus powered game made using Raylib",
        lang: "cpp",
    }
];

---

<Layout
    title="Damian Bednarczyk"
    description="Damian Bednarczyk is a mathematics undergraduate at Illinois State University specializing in computational mathematics and building open-source developer tools in Rust."
>
    <section class="mt-6 space-y-4 text-zinc-700 dark:text-zinc-300">
        <h1 class="sr-only">Damian Bednarczyk</h1>
        <p>
            I'm an undergraduate at Illinois State University studying computational
            mathematics with a minor in computer science.
            <br />
        </p>
        <p>
            You might be here looking for my
            <a href={aboutMe.github}>Github</a>,
            <a href="/resume.pdf">resume</a>, or
            <a href={aboutMe.email}>email</a>.
        </p>
        <p>... but if you're cool, maybe you're here for <i>me:</i></p>
        <ul class="list-disc pl-5">
            <li>Gaming nerd, currently obsessed with Path of Exile and Arc Raiders</li>
            <li>Member of Sigma Chi. IHSV</li>
            <li>
                Maybe we share a similar music taste:
                <details class="text-sm text-zinc-500 dark:text-zinc-500">
                    <summary class="cursor-pointer">
                        show topster (loads a 200kb ish <a
                            href="https://caniuse.com/avif"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-inherit">avif</a
                        >)
                    </summary>
                    <picture>
                        <source
                            srcset="https://cdn.bednarczyk.xyz/images/chart-dark.avif"
                            media="(prefers-color-scheme: dark)"
                        />
                        <img
                            src="https://cdn.bednarczyk.xyz/images/chart-light.avif"
                            alt="Music taste chart"
                            loading="lazy"
                            class="mt-4 rounded-lg"
                        />
                    </picture>
                </details>
            </li>
        </ul>

    </section>

    <section class="my-6">
        <h2 class="text-xl font-semibold">Projects</h2>

        <div
            class="mt-4 rounded-lg border border-zinc-200 dark:border-zinc-800"
        >
            <div class="grid grid-cols-2 text-sm">
                {projects.map((project) => <Project project={project} />)}
            </div>
        </div>
    </section>
</Layout>
