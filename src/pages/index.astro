---
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";

const aboutMe = {
    github: "https://github.com/dkbednarczyk",
    email: "mailto:damian@bednarczyk.xyz",
};

const projects = [
    {
        title: "mxw",
        url: "https://github.com/dkbednarczyk/mxw",
        description:
            "Cross platform CLI tool for configuring Glorious wireless mice.",
        lang: "rust",
    },
    {
        title: "mup",
        url: "https://github.com/dkbednarczyk/mup",
        description: "A swiss army knife for Minecraft servers.",
        lang: "rust",
    },
];
---

<Layout
    title="Damian Bednarczyk"
    description="Damian Bednarczyk is a mathematics undergraduate at Illinois State University specializing in computational mathematics."
>
    <section class="mt-6 space-y-4 text-zinc-700 dark:text-zinc-300">
        <p>
            Mathematics undergraduate at Illinois State University.
            <br />
            Find me on <a href={aboutMe.github}>Github</a>, or <a
                href={aboutMe.email}>send me an email</a
            >.
            <br />
            My <a href="/resume.pdf">resume</a>, if you're interested.
        </p>

        <p>
            I'm studying computational mathematics with a minor in computer
            science.
            <br />
            I speak Go, Python, and some Rust.
        </p>
    </section>

    <section class="my-6">
        <h2 class="text-xl font-semibold">Projects</h2>

        <div
            class="mt-4 rounded-lg border border-zinc-200 dark:border-zinc-800"
        >
            <div class="grid grid-cols-2 text-sm">
                {projects.map((project) => <Project project={project} />)}
            </div>
        </div>
    </section>

    <p class="text-zinc-700 dark:text-zinc-300">
        Right now I'm working on a Breakout-inspired game in C++ using Raylib as
        a learning exercise, including a custom ECS-like framework and full
        cross-platform compatibility.
    </p>
</Layout>
