---
import "@picocss/pico/css/pico.min.css"
import Project from "../components/Project.astro";

const aboutMe = {
	github: "https://github.com/dxbednarczyk",
	email: "mailto:damian@bednarczyk.xyz"
}

const projects = [
  {
    title: "dxbednarczyk/limestone",
    url: "https://github.com/dxbednarczyk/limestone",
    description: "A music downloader which supports most streaming services.",
  },
  {
    title: "ciderapp/Cidar",
    url: "https://github.com/ciderapp/Cidar",
    description: "A Discord bot designed to convert music links to Cider-friendly ones."
  },
  {
    title: "talwat/pap",
    url: "https://github.com/talwat/pap",
    description: "A swiss army knife for minecraft servers."
  },
  {
    title: "dxbednarczyk/zfetch",
    url: "https://github.com/dxbednarczyk/zfetch",
    description: "A sysfetch in <100 lines of Zig."
  }
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width initial-scale=1" />
    <meta name="generator" content={Astro.generator} >

    <link rel="apple-touch-icon" sizes="120x120" href="./apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="./favicon-16x16.png">
    <link rel="mask-icon" href="./safari-pinned-tab.svg" color="#5bbad5">

    <title>Damian's Corner</title>
  </head>
  <body>
    <main class="container">
      <h1>Damian Bednarczyk</h1>

      <p>
        High school student from Chicagoland learning systems programming.
        <br>
        Find me on 
        <a href={aboutMe.github}>Github</a>, or
        <a href={aboutMe.email}>send me an email</a>.
      </p>
      <br>
  
      <hgroup>        
        <h4>Projects</h4>
        <p>working on, have contributed to, or involved in</p>
      </hgroup>
  
      <figure>
        <table>
          <tbody>
            {projects.map((project) => <Project project={project} />)}
          </tbody>
        </table>
      </figure>
    </main>
  </body>
</html>
