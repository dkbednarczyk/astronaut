---
import "@picocss/pico/css/pico.min.css";
import Project from "../components/Project.astro";

const aboutMe = {
    github: "https://github.com/dxbednarczyk",
    email: "mailto:damian@bednarczyk.xyz",
};

const projects = [
    {
        title: "dxbednarczyk/mxw",
        url: "https://github.com/dxbednarczyk/mxw",
        description:
            "Cross platform CLI tool for configuring Glorious wireless mice.",
    },
    {
        title: "dxbednarczyk/mup",
        url: "https://github.com/dxbednarczyk/mup",
        description: "A swiss army knife for Minecraft servers.",
    }
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Damian Bednarczyk - Illinois State University mathematics undergraduate. Personal website, portfolio, and projects."
        />
        <meta name="keywords" content="Damian Bednarczyk, Illinois State University, mathematics, data science and computational mathematics" />
        <meta name="author" content="Damian Bednarczyk" />
        <!-- Open Graph tags for social sharing -->
        <meta property="og:title" content="Damian Bednarczyk" />
        <meta property="og:description" content="Personal website of Damian Bednarczyk, mathematics undergraduate and developer. Portfolio, projects, and contact info." />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://bednarczyk.xyz" />
        <meta property="og:image" content="https://bednarczyk.xyz/profile-picture.avif" />

        <link
            rel="apple-touch-icon"
            sizes="120x120"
            href="./apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="./favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="./favicon-16x16.png"
        />
        <link rel="mask-icon" href="./safari-pinned-tab.svg" color="#5bbad5" />

    <title>Damian Bednarczyk</title>

        <style>
            img {
                border-radius: 50%;
                height: 6em;
            }

            .aligned {
                display: flex;
                align-items: center;

                padding-bottom: 1em;
            }

            span {
                font-size: 2em;
                font-weight: bold;

                padding: 1em;
            }
        </style>
    </head>
    <body>
        <main class="container">
            <div class="aligned">
                <img src="./profile-picture.avif" alt="Damian Bednarczyk profile picture" />
                <h1 style="margin: 0 0 0 1em; font-size: 2em; font-weight: bold;">Damian Bednarczyk</h1>
            </div>

            <p>
                Mathematics undergraduate at Illinois State
                University.
                <br />
                Find me on
                <a href={aboutMe.github}>Github</a>, or
                <a href={aboutMe.email}>send me an email</a>.
                <br />
                My <a href="https://bednarczyk.xyz/resume.pdf">resume</a>, if you're interested.
            </p>

            <p>
                Studying data science and computational mathematics. I speak Go, Python, a bit of Rust, and Typst/LaTeX.
                <br />
                I'm a big <a href="https://www.last.fm/user/dxbednarczyk">music</a> and audio guy. Path of Exile is my current obsession.
            </p>
            <br />

            <hgroup>
                <h4>Projects</h4>
            </hgroup>

            <figure>
                <div class="overflow-auto">
                    <table>
                        <tbody>
                            {
                                projects.map((project) => (
                                    <Project project={project} />
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </figure>
        </main>
    </body>
</html>
