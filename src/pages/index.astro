---
import Project from '../components/Project.astro'

const aboutMe = {
	github: "https://github.com/dxbednarczyk",
	twitter: "https://x.com/dxbednarczyk",
	email: "mailto:me@dxbednarczyk.com"
}

const currentProjects = [
	{
		repo: "dxbednarczyk/limestone",
		url: "https://github.com/dxbednarczyk/limestone",
		description: "A music downloader which supports most streaming services.",
	},
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} >
    <title>Astro</title>
  </head>
  <body>
	<main class="container">
        <hgroup>
            <h1>dx's Corner</h1>
            <a href="https://mail.dxbednarczyk.com"><i class="bi-mailbox"></i></a>
            <a href="https://storage.dxbednarczyk.com"><i class="bi-archive"></i></a>
            <a href="https://notes.dxbednarczyk.com"><i class="bi-journal"></i></a>
            <a></a>
        </hgroup>

        <p>
            High school student from Chicagoland learning Go and Typescript.
            <br>
            <br>
            Find me on 
            <a href={aboutMe.github}>Github</a>,
            <a href={aboutMe.twitter}>Twitter/X</a>, or
            <a href={aboutMe.email}>send me an email</a>.
            <br>
            <br>
            Want to send me something? <a href="https://storage.dxbednarczyk.com/s/wc6nPosDkPjhOeM">Drop it here</a>.
        </p>
        <h2>Projects</h2>
        <ul>
			{currentProjects.map((project) => <Project project={project} />)}
        </ul>
    </main>
  </body>
</html>