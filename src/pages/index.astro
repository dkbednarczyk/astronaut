---
import "@picocss/pico/css/pico.min.css"
import Project from "../components/Project.astro";

const aboutMe = {
	github: "https://github.com/dxbednarczyk",
	email: "mailto:damian@bednarczyk.xyz"
}

const projects = [
  {
    title: "dxbednarczyk/limestone",
    url: "https://github.com/dxbednarczyk/limestone",
    description: "A music downloader which supports most streaming services.",
  },
  {
    title: "dxbednarczyk/mup",
    url: "https://github.com/dxbednarczyk/mup",
    description: "A swiss army knife for minecraft servers."
  },
  {
    title: "everywall/ladder",
    url: "https://github.com/everywall/ladder",
    description: "Self-hosted 12ft.io alternative. Bypass paywalls on any website."
  }
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width initial-scale=1" />
    <meta name="generator" content={Astro.generator} >

    <link rel="apple-touch-icon" sizes="120x120" href="./apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="./favicon-16x16.png">
    <link rel="mask-icon" href="./safari-pinned-tab.svg" color="#5bbad5">

    <title>Damian's Corner</title>

    <style>
      img {
        border-radius: 50%;
        height: 6em;
      }

      .aligned {
        display: flex;
        align-items: center;

        padding-bottom: 1em;
      }

      span {
        font-size: 2em;
        font-weight: bold;
        
        padding: 1em;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <div class="aligned">
        <img src="./profile-picture.png" alt="Profile" />
        <span>Damian Bednarczyk</span>
      </div>

      <p>
        Mathematics undergraduate at Illinois State University.
        <br>
        Find me on 
        <a href={aboutMe.github}>Github</a>, or
        <a href={aboutMe.email}>send me an email</a>.
      </p>
      <br>
  
      <hgroup>        
        <h4>Projects</h4>
        <p>working on, have contributed to, or involved in</p>
      </hgroup>
  
      <figure>
        <table>
          <tbody>
            {projects.map((project) => <Project project={project} />)}
          </tbody>
        </table>
      </figure>
    </main>
  </body>
</html>
