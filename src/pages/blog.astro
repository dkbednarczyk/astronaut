---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { byPubDateDesc, formatDate } from "@/utils";

const sortedPosts = (await getCollection("blog")).sort(byPubDateDesc);
---

<Layout
    title={`Blog - ${SITE_TITLE}`}
    description="Blog by Damian Bednarczyk on reverse engineering, systems programming, and AI-assisted development."
>
    <section>
        <h1 class="visually-hidden">Blog</h1>
        {
            sortedPosts.map((post) => (
                <article class="blog-listing">
                    <h2>
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </article>
            ))
        }
    </section>

    <p><a href="/rss.xml">RSS Feed</a></p>
</Layout>
