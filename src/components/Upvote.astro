---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<div class="upvote" data-slug={slug}>
    <button type="button" class="upvote-button" aria-pressed="false" disabled>
        <svg
            class="upvote-icon"
            viewBox="0 0 16 16"
            width="14"
            height="14"
            aria-hidden="true"
            focusable="false"
        >
            <path
                d="M8 3.5 13 9H3z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
        </svg>
        <span class="visually-hidden">Upvote</span>
        <span class="upvote-count">&ndash;</span>
    </button>
    <span class="visually-hidden" role="status"></span>
</div>

<style>
    .upvote {
        margin: 2rem 0;
    }

    .upvote-button {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        gap: 0.5rem;
        padding: 0.4rem 0.7rem;
        font: inherit;
        font-size: 0.9rem;
        color: inherit;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 6px;
        cursor: pointer;
    }

    .upvote-button:disabled {
        cursor: default;
        opacity: 0.55;
    }

    .upvote-button:hover:not(:disabled) {
        background: color-mix(in srgb, currentColor 8%, transparent);
    }

    .upvote-button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
    }

    /* Voted buttons are disabled too, but shouldn't look greyed out */
    .upvote-button[aria-pressed='true'] {
        background: color-mix(in srgb, currentColor 12%, transparent);
        opacity: 1;
    }

    .upvote-button[aria-pressed='true'] .upvote-icon path {
        fill: currentColor;
    }

    .upvote-icon {
        transform: translateY(-1px);
    }

    .upvote-count {
        font-variant-numeric: tabular-nums;
        min-width: 1ch;
        text-align: right;
    }
</style>

<script>
    type Votes = { count: number; voted: boolean };

    const root = document.querySelector<HTMLElement>(".upvote")!;
    const button = root.querySelector("button")!;
    const count = root.querySelector(".upvote-count")!;
    const status = root.querySelector("[role=status]")!;
    const endpoint = `/api/upvote/${root.dataset.slug}`;

    function render(votes: Votes) {
        count.textContent = String(votes.count);
        button.setAttribute("aria-pressed", String(votes.voted));
        button.disabled = votes.voted;
    }

    async function request(method: "GET" | "POST"): Promise<Votes> {
        const response = await fetch(endpoint, { method });
        if (!response.ok) throw new Error(`${method} ${endpoint}: ${response.status}`);
        return response.json();
    }

    request("GET").then(render, () => {
        status.textContent = "Vote count unavailable";
    });

    button.addEventListener("click", async () => {
        const previous = Number(count.textContent);
        status.textContent = "";
        render({ count: previous + 1, voted: true });

        try {
            render(await request("POST"));
        } catch {
            render({ count: previous, voted: false });
            status.textContent = "Could not record your vote. Try again.";
        }
    });
</script>
