---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<div class="upvote" data-upvote data-slug={slug}>
    <button
        type="button"
        class="upvote-button"
        aria-pressed="false"
        aria-label="Upvote this post"
        disabled
    >
        <svg
            class="upvote-icon"
            viewBox="0 0 16 16"
            width="14"
            height="14"
            aria-hidden="true"
            focusable="false"
        >
            <path
                d="M8 3.5 13 9H3z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
        </svg>
        <span class="upvote-count" aria-hidden="true">&ndash;</span>
        <span class="visually-hidden upvote-status">Loading vote count</span>
    </button>
</div>

<style>
    .upvote {
        margin: 2rem 0;
    }

    .upvote-button {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        gap: 0.5rem;
        padding: 0.4rem 0.7rem;
        font: inherit;
        font-size: 0.9rem;
        color: inherit;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 6px;
        cursor: pointer;
    }

    .upvote-button:disabled {
        cursor: default;
        opacity: 0.55;
    }

    .upvote-button:hover:not(:disabled) {
        background: color-mix(in srgb, currentColor 8%, transparent);
    }

    .upvote-button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
    }

    /* Voted buttons are disabled too, but shouldn't look greyed out */
    .upvote-button[aria-pressed='true'] {
        background: color-mix(in srgb, currentColor 12%, transparent);
        opacity: 1;
    }

    .upvote-button[aria-pressed='true'] .upvote-icon path {
        fill: currentColor;
    }

    .upvote-icon {
        transform: translateY(-1px);
    }

    .upvote-count {
        font-variant-numeric: tabular-nums;
        min-width: 1ch;
        text-align: right;
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>("[data-upvote]");
    if (root) {
        const button = root.querySelector("button")!;
        const count = root.querySelector(".upvote-count")!;
        const status = root.querySelector(".upvote-status")!;
        const endpoint = `/api/upvote/${encodeURIComponent(root.dataset.slug!)}`;

        function render(data: { count: number; voted: boolean }) {
            count.textContent = String(data.count);
            button.setAttribute("aria-pressed", String(data.voted));
            button.setAttribute("aria-label", data.voted ? "Upvoted" : "Upvote this post");
            status.textContent = data.voted ? "You upvoted this post" : "Upvote this post";
            button.disabled = data.voted;
        }

        async function request(method: "GET" | "POST") {
            const response = await fetch(endpoint, { method });
            if (!response.ok) throw response;
            return response.json();
        }

        request("GET")
            .then(render)
            .catch(() => {
                status.textContent = "Vote count unavailable";
            });

        button.addEventListener("click", async () => {
            const previous = Number(count.textContent);
            count.textContent = String(previous + 1);
            button.disabled = true;

            try {
                render(await request("POST"));
            } catch (error) {
                count.textContent = String(previous);
                if (error instanceof Response && error.status === 400) {
                    // The identity cookie was issued after this page loaded
                    status.textContent = "Reload the page to vote.";
                } else {
                    status.textContent = "Could not record your vote. Try again.";
                    button.disabled = false;
                }
            }
        });
    }
</script>
