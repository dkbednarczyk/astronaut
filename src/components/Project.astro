---
import { Image } from 'astro:assets';
import ferris from '../assets/rustacean-flat-noshadow.svg';
import java from '../assets/java-logo.svg';
import cpp from '../assets/cpp-logo.svg';

type Props = {
    project: {
        title: string,
        url: string,
        description: string,
        lang?: string
    }
}

const { project } = Astro.props;

const icons: Record<string, any> = {
    rust: ferris,
    java: java,
    cpp: cpp
};

const Icon = project.lang ? icons[project.lang] : null;
---

<div class="project">
    <div>
        {Icon && <Image src={Icon} alt={`${project.lang} icon`} class="lang-icon" />}
        <a href={project.url}>{project.title}</a>
    </div>
    <p class="description">{project.description}</p>
</div>

<style>
    .lang-icon {
        height: 1.1em;
        width: auto;
        vertical-align: middle;
        margin-right: 0.3em;
    }

    .description {
        margin: 0.25rem 0 0;
    }
</style>
