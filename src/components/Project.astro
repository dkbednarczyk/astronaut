---
import { Image } from "astro:assets";
import cpp from "../assets/cpp-logo.svg";
import go from "../assets/go-gopher.svg";
import java from "../assets/java-logo.svg";
import ferris from "../assets/rustacean-flat-noshadow.svg";

const icons = {
  rust: ferris,
  go,
  java,
  cpp,
};

type Props = {
  project: {
    title: string;
    url: string;
    description: string;
    lang?: keyof typeof icons;
  };
};

const { project } = Astro.props;

const Icon = project.lang ? icons[project.lang] : null;
---

<div class="project">
    <div>
        {Icon && <Image src={Icon} alt={`${project.lang} icon`} class="lang-icon" loading="eager" />}
        <a href={project.url}>{project.title}</a>
    </div>
    <p>{project.description}</p>
</div>

<style>
    .lang-icon {
        height: 1.1em;
        width: auto;
        vertical-align: middle;
        margin-right: 0.5em;
    }

    .project p {
        margin: 0.25rem 0 0;
    }
</style>
