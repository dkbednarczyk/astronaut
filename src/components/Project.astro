---
import { Image } from 'astro:assets';
import ferris from '../assets/rustacean-flat-noshadow.svg';
import java from '../assets/java-logo.svg';
import cpp from '../assets/cpp-logo.svg';

type Props = {
    project: {
        title: string,
        url: string,
        description: string,
        lang?: string
    }
}

const { project } = Astro.props;

const icons: Record<string, any> = {
    rust: ferris,
    java: java,
    cpp: cpp
};

const Icon = project.lang ? icons[project.lang] : null;
---

<div class="project">
    <div>
        {Icon && <Image src={Icon} alt={`${project.lang} icon`} style="height: 1.1em; width: auto; vertical-align: middle; margin-right: 0.3em;" />}
        <a href={project.url}>{project.title}</a>
    </div>
    <p style="margin: 0.25rem 0 0;">{project.description}</p>
</div>
