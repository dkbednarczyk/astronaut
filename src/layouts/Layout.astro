---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    publishedDate?: Date;
}

const { 
    title, 
    description = "Damian Bednarczyk - Mathematics undergraduate and software developer specializing in computational mathematics.",
    image = "/android-chrome-96x96.png",
    type = "website",
    publishedDate
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://bednarczyk.xyz");
const imageURL = new URL(image, "https://bednarczyk.xyz");

const jsonLd = {
    "@context": "https://schema.org",
    "@type": type === "article" ? "BlogPosting" : "WebSite",
    "name": title,
    "description": description,
    "url": canonicalURL.href,
    ...(type === "article" && publishedDate && {
        "datePublished": publishedDate.toISOString(),
        "author": {
            "@type": "Person",
            "name": "Damian Bednarczyk",
            "url": "https://bednarczyk.xyz"
        }
    }),
    ...(type === "website" && {
        "author": {
            "@type": "Person",
            "name": "Damian Bednarczyk",
            "url": "https://bednarczyk.xyz",
            "sameAs": [
                "https://github.com/dkbednarczyk",
                "https://www.linkedin.com/in/dkbednarczyk"
            ]
        }
    })
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="author" content="Damian Bednarczyk" />
        
        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL.href} />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL.href} />
        <meta property="og:site_name" content="Damian Bednarczyk" />
        
        <!-- Twitter -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:url" content={canonicalURL.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL.href} />
        
        <!-- Additional SEO -->
        <meta name="robots" content="index, follow" />
        <meta name="googlebot" content="index, follow" />
        
        <!-- Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        
        <title>{title}</title>
        <link
            rel="apple-touch-icon"
            sizes="120x120"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    </head>
    <body
        class="min-h-dvh bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
    >
        <main class="mx-auto px-4 max-w-3xl py-10">
            <Header />
            <slot />
        </main>
    </body>
</html>
